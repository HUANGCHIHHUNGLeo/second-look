# The screen's conversation runs on a Strands agent. Pick ONE model provider:
SECOND_LOOK_PROVIDER=openai          # or: gemini
OPENAI_API_KEY=                      # if provider=openai (default model gpt-4.1-mini)
GEMINI_API_KEY=                      # if provider=gemini, and to build guides from NEW videos
# SECOND_LOOK_MODEL=gpt-4.1-mini     # optional override

# Optional server settings
# CRV_GUIDE_DATA=~/.crv-guide
# CRV_GUIDE_PUBLIC_URL=http://127.0.0.1:8765
# CRV_GUIDE_ALLOWED_ORIGINS=http://127.0.0.1:8770,http://localhost:8770
